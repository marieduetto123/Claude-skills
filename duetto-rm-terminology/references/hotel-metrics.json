  "helpers": {
    "getLabel": "function(metric, isCompact) { return isCompact && metric.abbr ? metric.abbr : metric.full; }",
    "example": {
      "usage": "getLabel(metrics.adr, false) → 'Average Daily Rate'",
      "compact": "getLabel(metrics.adr, true) → 'ADR'"
