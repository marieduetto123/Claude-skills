  "rules": {
    "revparRule": "RevPAR is always 'RevPAR' — never abbreviated further, never written as RevPar, Revpar, or REVPAR",
    "defaultBehavior": "Use full term by default; fall back to abbreviation only in space-constrained contexts",
    "spaceConstrainedContexts": [
      "AG Grid columns with width < threshold",
      "Compact UI cells or labels",
      "Narrow column headers",
      "Mobile/responsive layouts"
    ],
